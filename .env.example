# 将本文件复制为 .env 后再填写真实配置。
# .env 包含敏感信息，请勿提交到版本库。

# ==================== 服务配置 ====================

# 后端监听端口
PORT=3000

# 允许访问后端的前端地址
CORS_ORIGIN=http://localhost:5173

# MongoDB 连接地址；生产环境请使用带鉴权的私有连接串
MONGODB_URI=mongodb://localhost:27017/vision-craft

# ==================== 身份认证 ====================

# 请替换为足够长的随机字符串，切勿使用此占位值部署生产环境
JWT_SECRET=replace-with-a-long-random-secret

# JWT 有效期，例如 7d、24h、30m
JWT_EXPIRES_IN=7d

# ==================== Schema 生成模型 ====================

# DeepSeek API 密钥
DEEPSEEK_API_KEY=

# DeepSeek OpenAI 兼容接口地址
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Schema 生成使用的模型
DEEPSEEK_MODEL=deepseek-flash

# 思考强度：low、high 或 max
DEEPSEEK_REASONING_EFFORT=high

# ==================== RAG 问答模型 ====================

# OpenAI 兼容服务的 API 密钥
DASHBOARD_API_KEY=

# OpenAI 兼容服务地址；需支持项目中配置的 glm-5.3 模型
DASHBOARD_BASE_URL=

# ==================== 联网搜索 ====================

# Exa 搜索 API 密钥，用于背景图等联网搜索功能
EXASEARCH_API_KEY=
